<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="FatimaGul - Handmade crochet crafts, gifts and custom creations.">
  <title>FatimaGul | Handmade Crochet</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #fffaf7;
      color: #3d2b25;
      line-height: 1.6;
    }

    header {
      background: #fff;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
      color: #9a5c63;
    }

    nav a {
      text-decoration: none;
      color: #3d2b25;
      margin-left: 20px;
      font-weight: 600;
    }

    nav a:hover {
      color: #b76e79;
    }

    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      padding: 70px 8%;
      background: linear-gradient(135deg, #fff5ef, #f8e6e1);
    }

    .hero-text {
      max-width: 600px;
    }

    .hero h1 {
      font-size: clamp(42px, 7vw, 75px);
      line-height: 1.05;
      color: #75434b;
      margin-bottom: 20px;
    }

    .hero h2 {
      font-size: 25px;
      margin-bottom: 15px;
      color: #9a5c63;
    }

    .hero p {
      font-size: 18px;
      margin-bottom: 30px;
      color: #604b45;
    }

    .buttons a {
      display: inline-block;
      padding: 13px 23px;
      margin-right: 10px;
      margin-bottom: 10px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
    }

    .primary {
      background: #9a5c63;
      color: white;
    }

    .secondary {
      border: 2px solid #9a5c63;
      color: #9a5c63;
    }

    .hero-art {
      width: 390px;
      height: 390px;
      border-radius: 50%;
      background: #ead0ca;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 130px;
      box-shadow: 0 20px 45px rgba(100,60,60,.15);
    }

    section {
      padding: 75px 8%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 38px;
      color: #75434b;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #76625d;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .card {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 7px 25px rgba(80,50,40,.08);
      transition: .3s;
    }

    .card:hover {
      transform: translateY(-7px);
    }

    .product-img {
      height: 210px;
      background: #f1ddd7;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 80px;
    }

    .card-content {
      padding: 20px;
    }

    .card h3 {
      color: #75434b;
      margin-bottom: 7px;
    }

    .price {
      font-size: 20px;
      font-weight: bold;
      color: #a65f68;
      margin: 10px 0;
    }

    .order-btn {
      display: inline-block;
      background: #9a5c63;
      color: white;
      text-decoration: none;
      padding: 9px 17px;
      border-radius: 20px;
      margin-top: 5px;
    }

    .about {
      background: #f8eae5;
    }

    .about-box {
      max-width: 850px;
      margin: auto;
      text-align: center;
      font-size: 18px;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      margin-top: 40px;
    }

    .feature {
      background: white;
      padding: 30px;
      border-radius: 18px;
      text-align: center;
      box-shadow: 0 7px 20px rgba(70,40,30,.07);
    }

    .feature-icon {
      font-size: 45px;
      margin-bottom: 10px;
    }

    .custom {
      background: #fff;
    }

    .custom-box {
      max-width: 900px;
      margin: auto;
      background: #f9eee9;
      padding: 45px;
      border-radius: 25px;
      text-align: center;
    }

    .custom-box h2 {
      color: #75434b;
      margin-bottom: 15px;
      font-size: 35px;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      margin-top: 35px;
    }

    .step {
      background: #fff;
      padding: 25px;
      border-radius: 15px;
    }

    .step span {
      display: block;
      font-size: 35px;
      color: #9a5c63;
      font-weight: bold;
    }

    .earning {
      background: #75434b;
      color: white;
      text-align: center;
    }

    .earning h2 {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .earning p {
      max-width: 750px;
      margin: auto;
      font-size: 18px;
    }

    .contact {
      background: #fff8f5;
    }

    .contact-box {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    .contact-item {
      margin: 15px 0;
      font-size: 18px;
    }

    .contact-item a {
      color: #9a5c63;
      font-weight: bold;
      text-decoration: none;
    }

    footer {
      background: #3d2b25;
      color: white;
      text-align: center;
      padding: 30px 15px;
    }

    footer a {
      color: #ffdcd5;
      text-decoration: none;
    }

    .social {
      margin: 15px 0;
      font-size: 18px;
    }

    @media (max-width: 900px) {
      .hero {
        flex-direction: column;
        text-align: center;
      }

      .hero-art {
        width: 280px;
        height: 280px;
        font-size: 90px;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
      }

      .features,
      .steps {
        grid-template-columns: 1fr;
      }

      nav {
        display: none;
      }
    }

    @media (max-width: 550px) {
      .products {
        grid-template-columns: 1fr;
      }

      section {
        padding: 55px 5%;
      }

      .custom-box {
        padding: 30px 20px;
      }
    }
  </style>
</head>


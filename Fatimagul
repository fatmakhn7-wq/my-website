<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FatmaGul | Crochet & Handmade</title>

<meta name="description"
content="FatmaGul - Beautiful crochet crafts, handmade gifts and cozy accessories.">

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,sans-serif;
  background:#fff8f3;
  color:#352c29;
  line-height:1.6;
}

a{
  text-decoration:none;
  color:inherit;
}

/* NAVBAR */
header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,248,243,.96);
  backdrop-filter:blur(12px);
  border-bottom:1px solid #eadbd2;
  padding:16px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:23px;
  font-weight:bold;
  color:#a85e57;
}

nav{
  display:flex;
  gap:25px;
}

nav a{
  font-size:14px;
  color:#5f5551;
}

nav a:hover{
  color:#a85e57;
}

.nav-btn{
  background:#352c29;
  color:white;
  padding:10px 18px;
  border-radius:30px;
  font-size:13px;
}

/* HERO */
.hero{
  min-height:680px;
  padding:80px 8%;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:50px;
  align-items:center;
}

.eyebrow{
  color:#a85e57;
  font-size:11px;
  font-weight:bold;
  letter-spacing:3px;
  margin-bottom:18px;
}

.hero h1{
  font-family:Georgia,serif;
  font-size:clamp(55px,8vw,100px);
  line-height:.98;
  letter-spacing:-4px;
}

.hero h1 span{
  display:block;
  color:#bd756c;
  font-style:italic;
}

.hero-text{
  max-width:570px;
  margin:28px 0;
  color:#6d625e;
  font-size:17px;
}

.buttons{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.btn{
  display:inline-block;
  padding:14px 23px;
  border-radius:30px;
  font-weight:bold;
  font-size:14px;
}

.primary{
  background:#d58d83;
  color:white;
}

.primary:hover{
  background:#a85e57;
}

.outline{
  border:1px solid #cdbbb2;
}

/* HERO ART */
.hero-art{
  display:flex;
  justify-content:center;
}

.art-circle{
  width:410px;
  height:410px;
  border-radius:50%;
  background:#e8c4b5;
  display:flex;
  justify-content:center;
  align-items:center;
  position:relative;
  box-shadow:20px 25px 50px rgba(60,40,30,.12);
}

.yarn{
  font-size:125px;
}

.flower{
  position:absolute;
  right:45px;
  bottom:55px;
  font-size:65px;
}

.label{
  position:absolute;
  left:10px;
  top:45px;
  background:white;
  padding:15px 22px;
  border-radius:12px;
  transform:rotate(-7deg);
  text-align:center;
  font-family:Georgia,serif;
  box-shadow:0 15px 30px rgba(50,30,20,.12);
}

.label strong{
  display:block;
  color:#a85e57;
  font-size:21px;
}

/* SHOP */
.shop{
  padding:90px 7%;
  background:#fffdfb;
}

.heading{
  text-align:center;
  margin-bottom:45px;
}

.heading h2{
  font-family:Georgia,serif;
  font-size:48px;
  line-height:1.1;
  margin-bottom:12px;
}

.heading p:last-child{
  color:#756a65;
}

.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

.product{
  background:white;
  border:1px solid #eadbd2;
  border-radius:22px;
  overflow:hidden;
  transition:.3s;
}

.product:hover{
  transform:translateY(-7px);
  box-shadow:0 20px 40px rgba(60,40,30,.12);
}

.product-image{
  height:220px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:90px;
}

.pink{background:#f2d3c7}
.cream{background:#eee1c9}
.green{background:#d7dfd0}
.purple{background:#ded1e1}

.product-info{
  padding:21px;
}

.badge{
  background:#f0e4db;
  padding:6px 9px;
  border-radius:20px;
  font-size:9px;
  letter-spacing:1px;
}

.product h3{
  margin:14px 0 7px;
}

.product p{
  color:#756a65;
  font-size:14px;
  min-height:65px;
}

.price{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:17px;
}

.order{
  color:#a85e57;
  font-weight:bold;
  font-size:14px;
}

/* ABOUT */
.about{
  padding:100px 8%;
  background:#e7d4c7;
  display:grid;
  grid-template-columns:1.3fr .7fr;
  gap:25px;
}

.about-box,
.quote-box{
  border-radius:28px;
  padding:52px;
}

.about-box{
  background:white;
}

.about-box h2{
  font-family:Georgia,serif;
  font-size:46px;
  line-height:1.1;
}

.about-box p{
  color:#6e625d;
  margin:20px 0;
}

.quote-box{
  background:#352c29;
  color:white;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.quote-mark{
  color:#d59a91;
  font-size:90px;
  line-height:.7;
}

.quote-box h3{
  font-family:Georgia,serif;
  font-size:27px;
  line-height:1.3;
  margin-top:25px;
}

.quote-box p{
  color:#d7c7c1;
  margin-top:18px;
}

/* WHY */
.why{
  padding:90px 7%;
  background:white;
}

.features{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.feature{
  padding:35px;
  border:1px solid #eadbd2;
  border-radius:22px;
}

.icon{
  font-size:35px;
  color:#a85e57;
}

.feature h3{
  margin:12px 0 7px;
}

.feature p{
  color:#756a65;
  font-size:14px;
}

/* CONTACT */
.contact{
  margin:0 6% 70px;
  padding:65px 7%;
  background:#d58d83;
  color:white;
  border-radius:30px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:35px;
}

.contact h2{
  font-family:Georgia,serif;
  font-size:48px;
  line-height:1.1;
}

.contact-text{
  margin-top:15px;
  color:#ffe9df;
}

.contact-buttons{
  display:flex;
  flex-direction:column;
  gap:12px;
  min-width:270px;
}

.contact-btn{
  background:white;
  color:#352c29;
  padding:15px 20px;
  border-radius:30px;
  text-align:center;
  font-weight:bold;
  transition:.2s;
}

.contact-btn:hover{
  transform:translateY(-2px);
  background:#fff2ed;
}

/* FOOTER */
footer{
  padding:35px 7%;
  border-top:1px solid #eadbd2;
  display:flex;
  justify-content:space-between;
  color:#756a65;
  font-size:13px;
}

.footer-name{
  color:#352c29;
  font-weight:bold;
}

/* MOBILE */
@media(max-width:900px){

  nav{
    display:none;
  }

  .hero{
    grid-template-columns:1fr;
    padding-top:60px;
  }

  .products{
    grid-template-columns:repeat(2,1fr);
  }

  .about{
    grid-template-columns:1fr;
  }

  .features{
    grid-template-columns:1fr;
  }

  .contact{
    flex-direction:column;
    align-items:flex-start;
  }
}

@media(max-width:560px){

  header{
    padding:15px 5%;
  }

  .nav-btn{
    padding:9px 13px;
  }

  .hero{
    padding:60px 6%;
  }

  .hero h1{
    font-size:62px;
  }

  .art-circle{
    width:300px;
    height:300px;
  }

  .yarn{
    font-size:90px;
  }

  .flower{
    font-size:48px;
    right:30px;
    bottom:40px;
  }

  .shop{
    padding:65px 6%;
  }

  .products{
    grid-template-columns:1fr;
  }

  .heading h2{
    font-size:40px;
  }

  .about{
    padding:65px 6%;
  }

  .about-box,
  .quote-box{
    padding:32px;
  }

  .about-box h2{
    font-size:38px;
  }

  .contact{
    margin:0 4% 45px;
    padding:42px 28px;
  }

  .contact h2{
    font-size:40px;
  }

  .contact-buttons{
    width:100%;
    min-width:0;
  }

  footer{
    flex-direction:column;
    padding:28px 6%;
  }
}
</style>

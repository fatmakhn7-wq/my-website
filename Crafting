<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="Fatma Gul - Beautiful crochet crafts, handmade gifts and cozy accessories.">

  <title>Fatma Gul | Crochet & Handmade</title>


  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      font-family: Arial, sans-serif;
      background: #fff8f3;
      color: #382e2b;
      line-height: 1.6;
    }


    a {
      text-decoration: none;
      color: inherit;
    }


    /* =========================
       NAVBAR
    ========================= */

    header {
      position: sticky;
      top: 0;
      z-index: 999;

      background: rgba(255,248,243,0.96);

      border-bottom: 1px solid #eadbd3;

      padding: 16px 6%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      backdrop-filter: blur(10px);
    }


    .logo {
      font-size: 22px;
      font-weight: bold;
      color: #a85f58;
    }


    nav {
      display: flex;
      gap: 25px;
    }


    nav a {
      font-size: 14px;
      color: #5f5450;
    }


    nav a:hover {
      color: #a85f58;
    }


    .top-button {
      background: #382e2b;
      color: white;

      padding: 10px 18px;

      border-radius: 30px;

      font-size: 13px;
    }



    /* =========================
       HERO
    ========================= */

    .hero {
      min-height: 650px;

      padding: 80px 8%;

      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 50px;

      align-items: center;
    }


    .eyebrow {
      color: #a85f58;

      font-size: 12px;

      font-weight: bold;

      letter-spacing: 3px;

      margin-bottom: 18px;
    }


    .hero h1 {
      font-family: Georgia, serif;

      font-size: clamp(55px, 8vw, 100px);

      line-height: 0.98;

      letter-spacing: -3px;
    }


    .hero h1 span {
      display: block;

      color: #b86c63;

      font-style: italic;
    }


    .hero-text {
      max-width: 570px;

      color: #6d625e;

      font-size: 17px;

      margin: 28px 0;
    }


    .buttons {
      display: flex;

      gap: 12px;

      flex-wrap: wrap;
    }


    .btn {
      display: inline-block;

      padding: 14px 23px;

      border-radius: 30px;

      font-size: 14px;

      font-weight: bold;
    }


    .btn-primary {
      background: #d58d83;

      color: white;
    }


    .btn-primary:hover {
      background: #a85f58;
    }


    .btn-outline {
      border: 1px solid #cdbbb2;
    }


    /* =========================
       HERO ART
    ========================= */

    .hero-art {
      display: flex;

      justify-content: center;

      align-items: center;
    }


    .art-circle {
      width: 410px;

      height: 410px;

      border-radius: 50%;

      background: #e8c4b5;

      position: relative;

      display: flex;

      align-items: center;

      justify-content: center;

      box-shadow:
        20px 25px 50px rgba(60,40,30,0.12);
    }


    .yarn {
      font-size: 125px;
    }


    .flower {
      position: absolute;

      right: 45px;

      bottom: 50px;

      font-size: 65px;
    }


    .made-label {
      position: absolute;

      left: 10px;

      top: 45px;

      background: white;

      padding: 15px 22px;

      border-radius: 12px;

      transform: rotate(-7deg);

      text-align: center;

      font-family: Georgia, serif;

      box-shadow:
        0 15px 30px rgba(50,30,20,0.12);
    }


    .made-label strong {
      display: block;

      color: #a85f58;

      font-size: 21px;
    }



    /* =========================
       SHOP
    ========================= */

    .shop {
      padding: 90px 7%;

      background: #fffdfb;
    }


    .section-title {
      text-align: center;

      margin-bottom: 45px;
    }


    .section-title h2 {
      font-family: Georgia, serif;

      font-size: 48px;

      line-height: 1.1;

      margin-bottom: 12px;
    }


    .section-title p:last-child {
      color: #756a65;
    }


    .products {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 20px;
    }


    .product {
      background: white;

      border: 1px solid #eadbd3;

      border-radius: 22px;

      overflow: hidden;

      transition: 0.3s;
    }


    .product:hover {
      transform: translateY(-7px);

      box-shadow:
        0 20px 40px rgba(60,40,30,0.12);
    }


    .product-image {
      height: 220px;

      display: flex;

      align-items: center;

      justify-content: center;

      font-size: 90px;
    }


    .pink {
      background: #f1d2c6;
    }


    .cream {
      background: #eee1c9;
    }


    .green {
      background: #d6dfd0;
    }


    .purple {
      background: #ded1e1;
    }


    .product-info {
      padding: 21px;
    }


    .badge {
      background: #f0e4db;

      padding: 6px 9px;

      border-radius: 20px;

      font-size: 9px;

      letter-spacing: 1px;
    }


    .product-info h3 {
      margin: 14px 0 7px;

      font-size: 18px;
    }


    .product-info p {
      color: #756a65;

      font-size: 14px;

      min-height: 65px;
    }


    .product-bottom {
      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-top: 17px;
    }


    .product-bottom strong {
      font-size: 16px;
    }


    .order-link {
      color: #a85f58;

      font-weight: bold;

      font-size: 14px;
    }



    /* =========================
       ABOUT
    ========================= */

    .about {
      padding: 100px 8%;

      background: #e7d4c7;

      display: grid;

      grid-template-columns:
        1.3fr .7fr;

      gap: 25px;
    }


    .about-box,
    .quote-box {
      border-radius: 28px;

      padding: 52px;
    }


    .about-box {
      background: white;
    }


    .about-box h2 {
      font-family: Georgia, serif;

      font-size: 46px;

      line-height: 1.1;
    }


    .about-box p {
      color: #6e625d;

      margin: 20px 0;
    }


    .quote-box {
      background: #382e2b;

      color: white;

      display: flex;

      flex-direction: column;

      justify-content: center;
    }


    .quote-mark {
      color: #d59a91;

      font-size: 90px;

      line-height: 0.7;
    }


    .quote-box h3 {
      font-family: Georgia, serif;

      font-size: 27px;

      line-height: 1.3;

      margin-top: 25px;
    }


    .quote-box p {
      color: #d7c7c1;

      margin-top: 18px;
    }



    /* =========================
       WHY US
    ========================= */

    .why {
      padding: 90px 7%;

      background: white;
    }


    .features {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 20px;
    }


    .feature {
      padding: 35px;

      border: 1px solid #eadbd3;

      border-radius: 22px;
    }


    .feature-icon {
      font-size: 35px;

      color: #a85f58;
    }


    .feature h3 {
      margin: 12px 0 7px;
    }


    .feature p {
      color: #756a65;

      font-size: 14px;
    }



    /* =========================
       BUSINESS CONTACT
    ========================= */

    .contact {
      margin: 0 6% 70px;

      padding: 65px 7%;

      background: #d58d83;

      color: white;

      border-radius: 30px;

      display: flex;

      justify-content: space-between;

      align-items: center;

      gap: 35px;
    }


    .contact h2 {
      font-family: Georgia, serif;

      font-size: 48px;

      line-height: 1.1;
    }


    .contact-description {
      margin-top: 15px;

      color: #ffe9df;
    }


    .contact-buttons {
      display: flex;

      flex-direction: column;

      gap: 12px;

      min-width: 260px;
    }


    .contact-button {
      background: white;

      color: #382e2b;

      padding: 15px 22px;

      border-radius: 30px;

      text-align: center;

      font-weight: bold;

      transition: .2s;
    }


    .contact-button:hover {
      transform: translateY(-2px);

      background: #fff2ed;
    }



    /* =========================
       FOOTER
    ========================= */

    footer {
      padding: 35px 7%;

      border-top: 1px solid #eadbd3;

      display: flex;

      justify-content: space-between;

      gap: 20px;

      color: #756a65;

      font-size: 13px;
    }


    .footer-brand {
      color: #382e2b;

      font-weight: bold;
    }



    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 900px) {

      nav {
        display: none;
      }


      .hero {
        grid-template-columns: 1fr;

        padding-top: 60px;
      }


      .products {
        grid-template-columns:
          repeat(2, 1fr);
      }


      .about {
        grid-template-columns: 1fr;
      }


      .features {
        grid-template-columns: 1fr;
      }


      .contact {
        flex-direction: column;

        align-items: flex-start;
      }

    }



    @media (max-width: 560px) {

      header {
        padding: 15px 5%;
      }


      .top-button {
        padding: 9px 13px;
      }


      .hero {
        padding: 60px 6%;
      }


      .hero h1 {
        font-size: 62px;
      }


      .art-circle {
        width: 300px;

        height: 300px;
      }


      .yarn {
        font-size: 90px;
      }


      .flower {
        font-size: 48px;

        right: 30px;

        bottom: 40px;
      }


      .shop {
        padding: 65px 6%;
      }


      .products {
        grid-template-columns: 1fr;
      }


      .section-title h2 {
        font-size: 40px;
      }


      .about {
        padding: 65px 6%;
      }


      .about-box,
      .quote-box {
        padding: 32px;
      }


      .about-box h2 {
        font-size: 38px;
      }


      .contact {
        margin: 0 4% 45px;

        padding: 42px 28px;
      }


      .contact h2 {
        font-size: 40px;
      }


      .contact-buttons {
        width: 100%;

        min-width: 0;
      }


      footer {
        flex-direction: column;

        padding: 28px 6%;
      }

    }

  </style>

</head>


